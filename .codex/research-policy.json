{
  "autoresearch": {
    "default_mode": "invoke",
    "mode_guard_entrypoint": "scripts/remote/guard-autoresearch-mode.ps1",
    "git_hook_entrypoint": ".githooks/pre-commit",
    "modes": {
      "invoke": {
        "skill_path": ".agents/skills/codex-autoresearch-v2",
        "may_modify_sealed_paths": false,
        "purpose": "Call the completed autoresearch v2 interface and edit only run inputs or declared target mutable paths."
      },
      "develop": {
        "skill_path": ".agents/skills/codex-autoresearch-v2-dev",
        "may_modify_sealed_paths": true,
        "purpose": "Develop, repair, or package the autoresearch v2 skill, runtime, guard, and plugin artifacts."
      }
    },
    "sealed_paths": [
      ".codex/research-policy.json",
      ".codex/autoresearch-v2-plugin.json",
      ".agents/skills/codex-autoresearch-v2/**",
      ".agents/skills/codex-autoresearch-v2-dev/**",
      "config/autoresearch-v2.example.psd1",
      "scripts/package-autoresearch-v2-plugin.ps1",
      "scripts/remote/guard-autoresearch-mode.ps1",
      "scripts/remote/autoresearch-v2.ps1",
      "scripts/remote/smoke-autoresearch-v2.ps1",
      "scripts/remote/select-profile.ps1",
      "scripts/remote/access/**",
      "scripts/remote/lib/common.ps1",
      "scripts/remote/lib/config.ps1",
      "scripts/remote/lib/remote_access.ps1",
      "scripts/remote/lib/autoresearch_v2.ps1",
      "scripts/remote/remote-bin/autoresearch_v2_*.py",
      "scripts/remote/remote-bin/run_autoresearch_v2_bridge.sh",
      "plugins/codex-autoresearch-v2/**"
    ],
    "invoke_mutable_inputs": [
      "autoresearch/program*.md",
      "autoresearch/targets/**",
      "config/autoresearch-v2.local.psd1"
    ],
    "packaged_plugin": {
      "path": "plugins/codex-autoresearch-v2",
      "version": "0.5.0",
      "mode": "invoke"
    }
  },
  "training": {
    "remote_only": true,
    "local_gpu_training": "forbidden",
    "allowed_entrypoints": [
      "scripts/remote/autoresearch-v2.ps1",
      "scripts/remote/smoke-autoresearch-v2.ps1"
    ]
  }
}
